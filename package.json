{
  "name": "ox-quiz-cloud",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "여러 행사를 위한 클라우드 OX 퀴즈 진행실과 프로젝션",
  "scripts": {
    "dev": "node tools/dev-cloud.mjs",
    "build": "node tools/build-cloud.mjs",
    "build:cloud": "node tools/build-cloud.mjs",
    "test": "node --test --test-isolation=none tools/*.test.mjs",
    "test:cloud": "node --test --test-isolation=none tools/cloud-*.test.mjs",
    "lint": "eslint .",
    "start": "node cloud/server.mjs",
    "start:cloud": "node cloud/server.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
