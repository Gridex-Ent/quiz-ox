# Non-secret production settings for the cloud presenter service.
# manual-cloud.ps1 writes these to run-env.yaml; it does not load this file.
NODE_ENV=production
PORT=8080
MANUAL_GCS_BUCKET=YOUR_EXISTING_PRIVATE_BUCKET
MANUAL_GCS_OBJECT=manual/state-v1.json
# Optional presenter link origin for a separately deployed read-only screen.
# PUBLIC_SCREEN_URL=https://YOUR_SCREEN_SERVICE.run.app

# Projection-only Docker target "screen" uses the settings below instead of GCS/PIN.
# MANUAL_SCREEN_UPSTREAM=https://YOUR_PRIVATE_PRESENTER_SERVICE.run.app
# MANUAL_SCREEN_SERVICE_ACCOUNT=screen-runtime@YOUR_PROJECT.iam.gserviceaccount.com
# Supply only MANUAL_SCREEN_KEY from Secret Manager to that screen service.

# MANUAL_HOST_PIN and MANUAL_SCREEN_KEY are required.
# They must contain at least 6 and 24 characters respectively.
# Supply existing numbered Secret Manager versions through:
# -HostPinSecret 'ox-manual-host-pin:1'
# -ScreenKeySecret 'ox-manual-screen-key:1'
# Do not put real PINs, screen keys, service-account JSON, or tokens in this file.
