# Production presenter runtime example; this file is documentation, not a secret store.
# npm run dev instead creates random local access values under ignored data/development/.
NODE_ENV=production
PORT=8080
MANUAL_GCS_BUCKET=YOUR_EXISTING_PRIVATE_BUCKET
MANUAL_GCS_OBJECT=manual/state-v1.json

# Required: inject MANUAL_HOST_PIN (at least 6 characters) and MANUAL_SCREEN_KEY
# (at least 24 characters) from numbered Secret Manager versions at deployment.
# Do not commit real PINs, screen keys, tokens, or service-account JSON.
# deploy/manual-cloud.ps1 accepts -HostPinSecret SECRET_NAME:VERSION
# and -ScreenKeySecret SECRET_NAME:VERSION, never the secret values.

# Optional presenter origin for request-origin checks.
# PUBLIC_URL=https://YOUR_PRIVATE_PRESENTER_SERVICE.run.app
# Optional origin for the separately deployed public screen.
# PUBLIC_SCREEN_URL=https://YOUR_PUBLIC_SCREEN_SERVICE.run.app

# The projection-only Docker target "screen" uses these settings and a screen-key
# secret instead of presenter PIN/GCS access:
# MANUAL_SCREEN_UPSTREAM=https://YOUR_PRIVATE_PRESENTER_SERVICE.run.app
# MANUAL_SCREEN_SERVICE_ACCOUNT=screen-runtime@YOUR_PROJECT.iam.gserviceaccount.com
